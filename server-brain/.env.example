# The Numen MCP endpoint remains loopback-only by default.
NUMEN_MCP_URL=http://127.0.0.1:8765/mcp
# Set this only when config/numen/mcp_server.json uses a non-empty token.
NUMEN_MCP_TOKEN=

MOMO_COMPANION=momo
# supervised only continues goals that began with an explicit player/test request.
# autonomous additionally permits body/task telemetry to open new continuation turns.
MOMO_ACTIVITY_MODE=supervised
MOMO_CLASSIFIER_MODEL=gpt-5.4-mini
MOMO_AGENT_MODEL=gpt-5.6-luna
MOMO_CLASSIFIER_REASONING=low
MOMO_AGENT_REASONING=high
# Hot selections are persisted here after first startup. This state file takes
# precedence over the two MOMO_AGENT_* bootstrap values without rewriting .env.
MOMO_MODEL_STATE_FILE=runtime/model-selection.json

# Only these exact Minecraft player names may use:
# 桃桃执行指令 /time set day
# Leave empty to disable the command bridge.
MOMO_COMMAND_PLAYERS=

# Resolved relative to MOMO_WORKING_DIRECTORY.
MOMO_PERSONA_FILE=persona/momo.md

MOMO_POLL_INTERVAL_MS=750
MOMO_EVENT_BATCH_SIZE=16
MOMO_MCP_TIMEOUT_MS=10000
MOMO_AGENT_TOOL_TIMEOUT_SECONDS=330

# Optional when codex is not on systemd's PATH.
CODEX_PATH=
